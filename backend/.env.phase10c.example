# EyeCare AI — Phase 10C provider-verification security switches
# Copy only the settings you need into your existing backend/.env.
# NEVER replace or upload your real .env from a patch.

# Phase 10C normal state: Doctor/Hospital clinical APIs require an approved
# provider verification record AND accountStatus=active.
ENFORCE_PROVIDER_VERIFICATION=true

# Phase 10A patient authorization remains separate from provider verification.
# A verified Doctor/Hospital still needs an accepted care relationship for
# patient-specific records when this is enabled.
REQUIRE_PATIENT_CONNECTION=true

# Keep false for the secure state. Use true only as a short transition before
# Phase 10D formal care connections are available, then turn it off again.
ALLOW_LEGACY_CLINICAL_RELATIONSHIPS=false
