# EyeCare AI Phase 10D - Doctor/Patient Care Connections
# Copy individual values into your real backend/.env only if needed.
# Do NOT replace your existing .env with this file.

# Phase 10C must remain enforced so only verified doctors can participate.
ENFORCE_PROVIDER_VERIFICATION=true

# Phase 10A/10D authorization must remain strict.
REQUIRE_PATIENT_CONNECTION=true

# Phase 10D now provides the formal relationship workflow, so the old
# appointment/prescription/report relationship bridge should stay disabled.
ALLOW_LEGACY_CLINICAL_RELATIONSHIPS=false
