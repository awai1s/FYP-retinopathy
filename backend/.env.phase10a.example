# EyeCare AI - Phase 10A optional security settings
# Copy ONLY the settings you want into your existing backend/.env.
# Do not replace your current database/JWT/email secrets with this file.

# Strict provider -> patient clinical access. Keep true.
REQUIRE_PATIENT_CONNECTION=true

# Phase 10C is now implemented. Keep this true so Doctor/Hospital clinical APIs
# require SuperAdmin-approved verification. Set false only for emergency rollback.
ENFORCE_PROVIDER_VERIFICATION=true

# Temporary migration bridge only. Strict Phase 10A behavior is false.
# If you must temporarily keep old doctor/hospital relationships working before
# Phase 10D creates formal care connections, set true, test, then turn it off.
ALLOW_LEGACY_CLINICAL_RELATIONSHIPS=false

# Local diagnostic endpoints (/test-email, /test-gmail, /network-test).
# Railway/production defaults to false even when omitted.
ENABLE_DIAGNOSTIC_ENDPOINTS=true

# Production: comma-separated exact frontend origins. Railway now expects this.
# Example only:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://app.yourdomain.com

# Existing GridFS uploads default to 5 MB and are capped at 25 MB by config.
UPLOAD_MAX_MB=5
