# EyeCare AI Phase 10E - optional non-secret configuration
# Do NOT replace your real backend/.env with this file.

# Public frontend URL embedded into Health Card QR codes.
# Production example:
# HEALTH_CARD_PUBLIC_BASE_URL=https://your-eyecare-frontend.example.com
# Local Expo Web can leave this blank; the backend derives the current host + port 8081.
HEALTH_CARD_PUBLIC_BASE_URL=

# Keep the Phase 10A/10C/10D security chain enabled.
ENFORCE_PROVIDER_VERIFICATION=true
REQUIRE_PATIENT_CONNECTION=true
ALLOW_LEGACY_CLINICAL_RELATIONSHIPS=false
