# ============================================================
# EyeCare AI RAG / Voice - OPTIONAL provider configuration
# ============================================================
# Typed RAG works without these values by using the local bilingual
# retrieval fallback. Do NOT commit real API keys to Git.

# Optional OpenAI-compatible chat model for more natural RAG wording.
# Example base URLs:
#   OpenAI:    https://api.openai.com/v1
#   OpenRouter:https://openrouter.ai/api/v1
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=

# Keep false unless you intentionally approve sending authorized patient
# context to the external LLM provider. Local fallback can use it without
# sending it outside your backend.
RAG_SEND_PRIVATE_CONTEXT=false

# Native Android/iOS speech-to-text. The endpoint must be compatible with
# OpenAI's /audio/transcriptions multipart contract.
# Web Chrome/Edge normally uses browser speech recognition and does not need it.
RAG_STT_API_KEY=
RAG_STT_URL=https://api.openai.com/v1/audio/transcriptions
RAG_STT_MODEL=gpt-4o-mini-transcribe
